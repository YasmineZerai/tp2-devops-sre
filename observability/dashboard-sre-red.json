      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "off"
            },
            "stacking": {
              "mode": "none"
            }
          },
