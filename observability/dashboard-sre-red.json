        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (route) (rate(http_requests_total{namespace=\"tp-app\",status=~\"5..\"}[1m])) / ignoring(route) group_left sum(rate(http_requests_total{namespace=\"tp-app\"}[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
