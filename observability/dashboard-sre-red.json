        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(http_requests_total{namespace=\"tp-app\",status=~\"5..\"}[1m])) / sum(rate(http_requests_total{namespace=\"tp-app\"}[1m]))",
          "legendFormat": "erreurs 5xx (%)"
